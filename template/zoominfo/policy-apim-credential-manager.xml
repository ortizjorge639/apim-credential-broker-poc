<!--
  DRAFT ONLY. Not ready to deploy.
  This example validates an Entra caller token and uses one fixed APIM
  Credential Manager connection for the upstream ZoomInfo token. It does
  NOT provide per-user Credential Manager connection selection or prove
  PKCE. Replace every {{...}} value using customer-approved configuration.
  Do not use this Entra validation block if the incoming Foundry token has
  a different issuer or audience.
-->
<policies>
  <inbound>
    <base />
    <validate-jwt
        header-name="Authorization"
        require-scheme="Bearer"
        failed-validation-httpcode="401"
        failed-validation-error-message="Unauthorized">
      <openid-config url="{{CALLER_OIDC_METADATA_URL}}" />
      <audiences>
        <audience>{{APIM_API_AUDIENCE}}</audience>
      </audiences>
      <issuers>
        <issuer>{{CALLER_TOKEN_ISSUER}}</issuer>
      </issuers>
      <!--
        Add caller application/user claims only after the customer confirms
        the token format and the identity allowed to call this API.
      -->
    </validate-jwt>
    <get-authorization-context
        provider-id="{{APIM_CREDENTIAL_PROVIDER_ID}}"
        authorization-id="{{APIM_CONNECTION_ID}}"
        context-variable-name="zoominfo-auth"
        identity-type="managed"
        ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + ((Authorization)context.Variables.GetValueOrDefault("zoominfo-auth"))?.AccessToken)</value>
    </set-header>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
